<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/navbar') %>

    <div class="container mt-5">
      <h1><%= blog.title %></h1>
      <img src="<%= blog.coverImageURL %>" width="700px" />
    
      <pre class = "mt-3"><%= blog.body %></pre>
    </div>
    
  <div class="mt-4 mb-3">
        <img src="<%= blog.createdBy.profileImageURL %>" width="50px" class="rounded-circle" width="50px" />
        <strong><%= blog.createdBy.fullName %></strong>
      </div>


    <div class="container mt-4">
      <% if(comments && comments.length > 0) { %>
        <% comments.forEach((comment) => { %>
          <div class="mb-3">
            <img src="<%= comment.createdBy.profileImageURL %>" width="100px" />
            <%= comment.createdBy.fullName %>
            <pre><%= comment.content %></pre>
          </div>
        <% }); %>
      <% } else { %>
        <p>No comments yet</p>
      <% } %>
    </div>



    <%- include('./partials/scripts') %>
  </body>
</html>
